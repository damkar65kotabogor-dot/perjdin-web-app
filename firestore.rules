rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Perjalanan Dinas Collection
    match /perjalanan_dinas/{perjadinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(perjadinId)
        && request.resource.data.keys().hasAll(['id', 'bulan', 'tahun', 'uraian', 'skpd', 'kotaTujuan', 'jumlahTotal'])
        && request.resource.data.id is string
        && request.resource.data.uraian is string
        && request.resource.data.uraian.size() <= 2000;
      allow update: if isSignedIn() && isValidId(perjadinId)
        && request.resource.data.id == resource.data.id;
      allow delete: if isSignedIn() && isValidId(perjadinId);
    }

    // User Profile Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
